FROM node:22-bullseye

RUN apt-get update && apt-get install -y \
    git curl jq ripgrep fd-find unzip docker.io \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/configure-git-safe-directories.sh /usr/local/bin/configure-git-safe-directories
COPY scripts/bootstrap-opencode-config.sh /usr/local/bin/bootstrap-opencode-config
RUN chmod +x /usr/local/bin/configure-git-safe-directories
RUN chmod +x /usr/local/bin/bootstrap-opencode-config

RUN npm install -g opencode-ai @openchamber/web
RUN mkdir -p /opt/openchamber/plugins \
    && npm install --prefix /opt/openchamber/plugins oh-my-opencode-slim

COPY config-template /opt/openchamber/config-template

WORKDIR /workspace
