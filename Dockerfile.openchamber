FROM node:22-bullseye

RUN apt-get update && apt-get install -y \
    git curl jq ripgrep fd-find unzip docker.io \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g opencode-ai @openchamber/web

# Instalar oh-my-opencode-slim persistente
RUN mkdir -p /root/.config/opencode \
    && cd /root/.config/opencode \
    && npm init -y \
    && npm install oh-my-opencode-slim \
    && cat > /root/.config/opencode/opencode.json <<EOF
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file:///root/.config/opencode/node_modules/oh-my-opencode-slim/dist/index.js"
  ],
  "provider": {
    "openai": {}
  },
  "model": "openai/gpt-5.4",
  "small_model": "openai/gpt-5.4-mini",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
EOF

WORKDIR /workspace
